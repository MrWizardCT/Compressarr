<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Framework-dependent deployment (switched from self-contained as of 2.1.1, 2026-09-05: the
         self-contained build's size and lack of publisher reputation triggered a Windows Defender
         cloud/SmartScreen false positive - see installer/Compressarr.iss). Requires the matching
         .NET runtime already installed on the target machine. Multi-targeted so the Windows build
         can carry a real Windows.UI.Notifications toast implementation (needs a windows-flavored
         TFM to reference the raw .winmd metadata) while macOS/Linux stay on the plain
         cross-platform TFM. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.19041.0'">
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- Embeds the icon into the exe's own Win32 resources - without this, Explorer/Start Menu/
         taskbar shortcuts all fall back to a generic default icon regardless of what icon the
         installer's shortcut entry points at. -->
    <ApplicationIcon>Assets\CompressarrIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0'">
    <RuntimeIdentifiers>linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />

    <!-- Also copied as a loose file (not just embedded as an Avalonia resource) so the Windows
         toast notification can reference it by a real file path - AppLogoOverride needs a
         file:///, http(s)://, or ms-appx:/// URI, none of which an avares:// resource satisfies. -->
    <None Include="Assets\CompressarrLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Windows-only toast notification source, excluded from the plain net10.0 (macOS/Linux) build
       since Windows.UI.Notifications types won't compile there at all. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <Compile Remove="Notifications\WindowsNotificationService.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compressarr.Core\Compressarr.Core.csproj" />
    <ProjectReference Include="..\Compressarr.Web\Compressarr.Web.csproj" />
  </ItemGroup>
</Project>
