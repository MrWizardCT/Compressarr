<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Compressarr.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Compressarr.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/CompressarrIcon.ico"
        Title="Compressarr"
        Width="1100" Height="700">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel Margin="12">

        <!-- Button bar + status -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,10,0,0">
            <Button Grid.Column="0" Content="Save Settings" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Refresh Presets" Command="{Binding RefreshPresetsCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Run Once" Command="{Binding RunOnceCommand}" IsEnabled="{Binding !IsRunning}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" VerticalAlignment="Center" />
        </Grid>

        <!-- Main content: settings/lanes on the left, live log on the right -->
        <Grid ColumnDefinitions="2*,12,1*">

            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="10">

                    <TextBlock Text="HandBrake" FontWeight="Bold" FontSize="16" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="HandBrakeCLI path:" Width="140" VerticalAlignment="Center" />
                        <TextBox Text="{Binding HandBrakeCliPath}" Width="500" />
                        <Button Content="Check/Install HandBrakeCLI" Click="OnCheckHandBrakeClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="presets.json path:" Width="140" VerticalAlignment="Center" />
                        <TextBox Text="{Binding PresetsPath}" Width="500" />
                        <Button Content="Install/Merge Compressarr Presets" Click="OnInstallPresetsClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Extra CLI options:" Width="140" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ExtraOptions}" Width="500" />
                    </StackPanel>

                    <TextBlock Text="Processing" FontWeight="Bold" FontSize="16" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Video extensions:" Width="140" VerticalAlignment="Center" />
                        <TextBox Text="{Binding VidTypes}" Width="300" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Minimum size:" Width="140" VerticalAlignment="Center" />
                        <TextBox Text="{Binding MinSize}" Width="120" />
                        <TextBlock Text="Max files/run (0 = no limit):" Width="180" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Limit}" Width="120" Minimum="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="Write output to same folder as input" IsChecked="{Binding OutSameAsIn}" />
                        <CheckBox Content="Move converted files into show/movie folders" IsChecked="{Binding MoveFiles}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Original file after convert:" Width="180" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding DeleteModes}" SelectedItem="{Binding DeleteAfterConvert}" Width="150" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <TextBlock Grid.Column="0" Text="Lanes" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Add Lane" Command="{Binding AddLaneCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Lanes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LaneViewModel">
                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <CheckBox Grid.Column="0" Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="1" Text="{Binding DisplayName}" Width="220" HorizontalAlignment="Left" PlaceholderText="Lane name" />
                                            <Button Grid.Column="2" Content="Remove Lane" Click="OnRemoveLaneClick" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" >
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Input:" Margin="0,4,8,0" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Input}" Margin="0,4,10,0" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Output:" Margin="0,4,8,0" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Output}" Margin="0,4,0,0" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="TV preset:" Margin="0,4,8,0" VerticalAlignment="Center" />
                                            <AutoCompleteBox Grid.Row="1" Grid.Column="1" Text="{Binding TvPreset}" ItemsSource="{Binding AvailablePresets}" Margin="0,4,10,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Movie preset:" Margin="0,4,8,0" VerticalAlignment="Center" />
                                            <AutoCompleteBox Grid.Row="1" Grid.Column="3" Text="{Binding MoviePreset}" ItemsSource="{Binding AvailablePresets}" Margin="0,4,0,0" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="TV base path:" Margin="0,4,8,0" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TvShowBasePath}" Margin="0,4,10,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Movie base path:" Margin="0,4,8,0" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding MovieBasePath}" Margin="0,4,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="1" Background="Gray" HorizontalAlignment="Stretch" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="Bold" FontSize="16" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="12" />
            </DockPanel>

        </Grid>
    </DockPanel>

</Window>
